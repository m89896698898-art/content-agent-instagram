{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.local/schemas/phase_b_result.schema.json",
  "title": "CONTENT AGENT Phase B completion result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "output_folder",
    "slide_files",
    "qa_passed",
    "anti_repeat_passed",
    "posts_history_updated",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "status": {"const": "PHASE_B_COMPLETE"},
    "output_folder": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slide_files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {"type": "string", "pattern": "^[0-9]{2}\\.jpg$"}
    },
    "qa_passed": {"const": true},
    "anti_repeat_passed": {"const": true},
    "posts_history_updated": {"const": true},
    "summary": {"type": "string", "minLength": 20, "maxLength": 3000}
  }
}
