{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.local/schemas/phase_a_state.schema.json",
  "title": "CONTENT AGENT Phase A state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "status",
    "publication_date",
    "output_folder",
    "selected_topic",
    "topic_type",
    "target_segment",
    "problem",
    "objective",
    "main_thesis",
    "angle",
    "choice_reason",
    "alternative_topics",
    "practical_takeaway",
    "format",
    "hooks",
    "slides",
    "caption",
    "sources",
    "content_brief_markdown",
    "editorial_brief_markdown",
    "hook_report_markdown",
    "visual_brief_markdown",
    "research_report_markdown",
    "phase_a_quality_notes",
    "image_requests"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "PHASE_A_COMPLETE"},
    "publication_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "output_folder": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "selected_topic": {"type": "string", "minLength": 5, "maxLength": 300},
    "topic_type": {"type": "string", "minLength": 3, "maxLength": 100},
    "target_segment": {"type": "string", "minLength": 10, "maxLength": 500},
    "problem": {"type": "string", "minLength": 10, "maxLength": 1000},
    "objective": {"type": "string", "minLength": 10, "maxLength": 500},
    "main_thesis": {"type": "string", "minLength": 10, "maxLength": 1000},
    "angle": {"type": "string", "minLength": 10, "maxLength": 1000},
    "choice_reason": {"type": "string", "minLength": 20, "maxLength": 2000},
    "alternative_topics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "reason_not_selected"],
        "properties": {
          "topic": {"type": "string", "minLength": 5, "maxLength": 300},
          "reason_not_selected": {"type": "string", "minLength": 10, "maxLength": 1000}
        }
      }
    },
    "practical_takeaway": {"type": "string", "minLength": 10, "maxLength": 1000},
    "format": {"const": "carousel"},
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_15", "shortlist_5", "finalists_3", "winner", "winner_reason"],
      "properties": {
        "all_15": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "string", "minLength": 5, "maxLength": 300}},
        "shortlist_5": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 5, "maxLength": 300}},
        "finalists_3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 5, "maxLength": 300}},
        "winner": {"type": "string", "minLength": 5, "maxLength": 300},
        "winner_reason": {"type": "string", "minLength": 10, "maxLength": 1000}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_number",
          "function",
          "main_idea",
          "text",
          "reader_understanding",
          "reason_to_continue",
          "visual_direction",
          "ai_scene_output_filename"
        ],
        "properties": {
          "slide_number": {"type": "integer", "minimum": 1, "maximum": 10},
          "function": {"type": "string", "minLength": 3, "maxLength": 300},
          "main_idea": {"type": "string", "minLength": 5, "maxLength": 500},
          "text": {"type": "string", "minLength": 1, "maxLength": 1500},
          "reader_understanding": {"type": "string", "minLength": 5, "maxLength": 500},
          "reason_to_continue": {"type": "string", "minLength": 1, "maxLength": 500},
          "visual_direction": {"type": "string", "minLength": 5, "maxLength": 1500},
          "ai_scene_output_filename": {"type": "string", "maxLength": 32}
        }
      }
    },
    "caption": {"type": "string", "minLength": 20, "maxLength": 5000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publication_date", "accessed_date", "source_type", "claims_supported", "limitations"],
        "properties": {
          "title": {"type": "string", "minLength": 3, "maxLength": 500},
          "url": {"type": "string", "pattern": "^https://"},
          "publication_date": {"type": "string", "minLength": 4, "maxLength": 30},
          "accessed_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "source_type": {"type": "string", "enum": ["primary", "secondary", "auxiliary"]},
          "claims_supported": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 5, "maxLength": 1000}},
          "limitations": {"type": "string", "maxLength": 1500}
        }
      }
    },
    "content_brief_markdown": {"type": "string", "minLength": 100, "maxLength": 15000},
    "editorial_brief_markdown": {"type": "string", "minLength": 100, "maxLength": 15000},
    "hook_report_markdown": {"type": "string", "minLength": 100, "maxLength": 15000},
    "visual_brief_markdown": {"type": "string", "minLength": 100, "maxLength": 20000},
    "research_report_markdown": {"type": "string", "minLength": 100, "maxLength": 30000},
    "phase_a_quality_notes": {"type": "string", "minLength": 20, "maxLength": 5000},
    "image_requests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requests"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "requests": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_number", "prompt", "intended_visual_meaning", "composition", "aspect_ratio", "whether_text_must_be_absent", "output_filename", "required"],
            "properties": {
              "slide_number": {"type": "integer", "minimum": 1, "maximum": 10},
              "prompt": {"type": "string", "minLength": 40, "maxLength": 4000},
              "intended_visual_meaning": {"type": "string", "minLength": 10, "maxLength": 1000},
              "composition": {"type": "string", "minLength": 10, "maxLength": 1500},
              "aspect_ratio": {"const": "4:5"},
              "whether_text_must_be_absent": {"const": true},
              "output_filename": {"type": "string", "pattern": "^scene_[0-9]{2}\\.png$"},
              "required": {"const": true}
            }
          }
        }
      }
    }
  }
}
