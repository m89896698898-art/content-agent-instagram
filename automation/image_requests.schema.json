{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.local/schemas/image_requests.schema.json",
  "title": "CONTENT AGENT image requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "requests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_number",
          "prompt",
          "intended_visual_meaning",
          "composition",
          "aspect_ratio",
          "whether_text_must_be_absent",
          "output_filename",
          "required"
        ],
        "properties": {
          "slide_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "prompt": {
            "type": "string",
            "minLength": 40,
            "maxLength": 4000
          },
          "intended_visual_meaning": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "composition": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1500
          },
          "aspect_ratio": {
            "const": "4:5"
          },
          "whether_text_must_be_absent": {
            "const": true
          },
          "output_filename": {
            "type": "string",
            "pattern": "^scene_[0-9]{2}\\.png$"
          },
          "required": {
            "const": true
          }
        }
      }
    }
  }
}
