# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администратора(ов), через запятую. Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Токен платёжного провайдера из @BotFather -> Payments (например, ЮKassa).
# Если оставить пустым — бот работает в ручном режиме оплаты (см. README_BOT.md).
PROVIDER_TOKEN=

# Текст с реквизитами для ручного режима оплаты (если PROVIDER_TOKEN пуст)
MANUAL_PAYMENT_INSTRUCTIONS="Переведите сумму на карту 0000 0000 0000 0000 (Т-Банк) и пришлите сюда скриншот чека."

# Ссылка на самозапись (Calendly/Zoom и т.п.) на 20-минутный разбор и созвон по диагностике.
# Если пусто — бот сам соберёт имя/контакт/удобное время и передаст админу.
BOOKING_URL=

# Ссылка на личный Telegram Хасбуллы (t.me/username). ОБЯЗАТЕЛЬНО заполнить:
# после бесплатной диагностики, записи на разбор и оплаты платной диагностики
# бот отдаёт эту ссылку — дальше человек переписывается с Хасбуллой лично,
# в его личных сообщениях, а не в боте.
HASBULLA_PERSONAL_URL=https://t.me/username

PRODUCT1_PRICE_RUB=990
PRODUCT2_PRICE_RUB=14900

# Путь к файлу продукта "Дорогой час" (PDF/текст), который бот отправит после оплаты
PRODUCT1_CONTENT_PATH=data/product_dorogoy_chas.pdf

CHANNEL_URL=
INSTAGRAM_URL=https://instagram.com/hasbulla_gubdenskiy
